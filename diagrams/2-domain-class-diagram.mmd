classDiagram
    direction LR

    class Student {
        +number id
        +string email
        +string fullName
        +boolean verified
    }

    class Ride {
        +number id
        +string origin
        +string destination
        +Date departureAt
        +number totalSeats
        +number seatsAvailable
        +number pricePerSeat
    }

    class Booking {
        +number id
        +BookingStatus status
        +Date createdAt
    }

    class BookingStatus {
        <<enumeration>>
        CONFIRMED
        CANCELLED
    }

    class Payment {
        <<I2 - planned>>
        +number amount
        +string gatewayRef
        +string idempotencyKey
        +PaymentStatus status
    }

    class Rating {
        <<I3 - planned>>
        +number score
        +string comment
    }

    class Report {
        <<I3 - planned>>
        +string reason
        +string status
    }

    Student "1" --> "0..*" Ride : drives
    Student "1" --> "0..*" Booking : passenger
    Ride "1" --> "0..*" Booking : has
    Booking --> BookingStatus
    Booking "1" --> "0..1" Payment : paid by
    Student "1" --> "0..*" Rating : gives
    Student "1" --> "0..*" Report : files
